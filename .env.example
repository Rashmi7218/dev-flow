# GitHub App (see RESOURCES.md for the full creation walkthrough)
GITHUB_WEBHOOK_SECRET=changeme
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=your-app-slug
# Multi-line PEM — wrap in quotes and keep the real line breaks, python-dotenv parses this fine:
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIEowIBAAKCAQEA...
-----END RSA PRIVATE KEY-----"

# Jira
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_api_token
JIRA_PROJECT_KEY=KAN
JIRA_WEBHOOK_TOKEN=changeme

# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your_signing_secret
SLACK_DEFAULT_CHANNEL=#engineering

# Database (only needed when running the app outside docker-compose)
DATABASE_URL=postgresql+asyncpg://devflow:devflow@localhost:5432/devflow

# Groq (Phase 2 — PR summarization)
GROQ_API_KEY=gsk_your_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Admin dashboard (HTTP Basic Auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
